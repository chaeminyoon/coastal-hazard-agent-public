+    expect(screen.getByRole("button", { name: "Draw a custom area" })).toBeInTheDocument();
+    expect(api.spatialFeatures).toHaveBeenCalledWith("부산광역시", ["5"], [], "강풍");
+    act(() => setLocale("ko", false));
+    expect(screen.getByRole("button", { name: "사용자 영역 그리기" })).toBeInTheDocument();
+    expect(screen.getByRole("option", { name: "강풍" })).toHaveValue("강풍");
+    act(() => setLocale("en", false));
+    expect(screen.getByRole("button", { name: "Draw a custom area" })).toBeInTheDocument();
+    expect(api.spatialFeatures).toHaveBeenCalledTimes(1);
+  });
+
+  it("localizes export options while preserving export enums and grade keys", async () => {
+    const exportSpy = vi.spyOn(api, "spatialExport").mockResolvedValue({
+      image_id: "image-1", filename: "map.png", download_url: "/map.png", caption: "원본 설명",
+      region: "부산광역시", feature_count: 2, width: 100, height: 100,
+    } as never);
+    render(<SpatialStudio {...props()} />);
+    fireEvent.click(screen.getByRole("button", { name: "Save current map image" }));
+    const dialog = screen.getByRole("dialog", { name: "Map image export options" });
+    fireEvent.click(within(dialog).getByRole("radio", { name: "Transparent" }));
+    fireEvent.click(within(dialog).getByRole("button", { name: "Create image with these options" }));
+    await waitFor(() => expect(exportSpy).toHaveBeenCalledWith({
+      region: "부산광역시", metric: "강풍", grades: ["5"], focus_names: [], background: "transparent", extent: "region",
+    }));
+    expect(await screen.findByRole("link", { name: "Download PNG" })).toHaveAttribute("download", "map.png");
+  });
+
+  it("updates exported operation controls and preserves unrecognized source narrative", () => {
+    const operation = { operation_id: "op1", operation: "query_scope", name: "질문에 사용된 데이터 조회 범위", summary: "원본 데이터 설명" } as SpatialOperationResult;
+    render(<OperationResultCard operation={operation} saved={false} reportSelected={false} onKeep={vi.fn()} onToggleReport={vi.fn()} />);
+    expect(screen.getByText("SQL query extent")).toBeInTheDocument();
+    expect(screen.getByText("Data query extent used for the question")).toBeInTheDocument();
+    expect(screen.getByText("원본 데이터 설명")).toBeInTheDocument();
+    act(() => setLocale("ko", false));
+    expect(screen.getByRole("button", { name: "조회 결과 팝업 닫기" })).toBeInTheDocument();
+    expect(operation.name).toBe("질문에 사용된 데이터 조회 범위");
+  });
+
+  it("localizes drawing validation at call time without changing coordinate order", () => {
+    expect(() => buildSelectionGeometry([])).toThrow("Select at least three points");
+    setLocale("ko", false);
+    expect(() => buildSelectionGeometry([])).toThrow("영역을 만들려면");
+    expect(buildSelectionGeometry([[35, 129], [36, 129], [36, 130]]).coordinates[0])
+      .toEqual([[129, 35], [129, 36], [130, 36], [129, 35]]);
+  });
+});
