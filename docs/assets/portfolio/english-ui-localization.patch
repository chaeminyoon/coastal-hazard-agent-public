+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import UsageGuideContent from "../src/UsageGuide";
+import { setLocale } from "../src/i18n";
+
+beforeEach(() => setLocale("en", false));
+afterEach(() => { cleanup(); setLocale("en", false); });
+
+describe("user guide locale", () => {
+  it("renders all eight sections in English while retaining the real report command", () => {
+    const onClose = vi.fn();
+    const { container } = render(<UsageGuideContent onClose={onClose} />);
+    expect(screen.getByRole("heading", { name: "From question to report: an eight-step practical guide" })).toBeInTheDocument();
+    expect(screen.getByRole("navigation", { name: "User guide contents" })).toBeInTheDocument();
+    expect(container.querySelectorAll("article")).toHaveLength(8);
+    expect(screen.getAllByRole("link")).toHaveLength(8);
+    expect(screen.getAllByRole("img")).toHaveLength(9);
+    expect(screen.getAllByText("Illustrative workflow, no production data")).toHaveLength(9);
+    expect(screen.getByText(/not a standalone end-to-end demo/)).toBeInTheDocument();
+    expect(screen.getByText(/This Korean command starts report writing; keep the command unchanged/)).toBeInTheDocument();
+    expect(screen.getByText("Show the SQL used for this result and the total query row count.")).toBeInTheDocument();
+    expect(screen.getByText(/up to 10 materials/)).toBeInTheDocument();
+    expect(container.textContent).not.toContain("/report");
+    // The protocol command is deliberately Korean; other English-mode display text is translated.
+    expect(container.textContent?.replaceAll("/보고서작성", "")).not.toMatch(/[가-힣]/);
+    expect(screen.getAllByText("/보고서작성", { selector: "code" })).toHaveLength(2);
+    for (const image of screen.getAllByRole("img")) {
+      expect(image).toHaveAccessibleName(expect.stringContaining("Schematic:"));
+      expect(image).toHaveAccessibleName(expect.stringContaining("Illustrative workflow, no production data"));
+    }
+    fireEvent.click(screen.getByRole("button", { name: "Close" }));
+    expect(onClose).toHaveBeenCalledOnce();
+  });
+
+  it("reacts to locale changes without remounting and preserves section anchors and commands", () => {
+    const { container } = render(<UsageGuideContent onClose={vi.fn()} />);
+    const links = screen.getAllByRole("link").map((link) => link.getAttribute("href"));
+    act(() => setLocale("ko", false));
+    expect(screen.getByRole("heading", { name: "질문에서 보고서까지, 8단계 실무 가이드" })).toBeInTheDocument();
+    expect(screen.getByRole("navigation", { name: "사용 방법 목차" })).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "닫기" })).toBeInTheDocument();
+    expect(screen.getByText("이 결과에 사용된 SQL과 전체 조회 건수를 보여줘")).toBeInTheDocument();
+    expect(screen.getAllByText("/보고서작성", { selector: "code" })).toHaveLength(2);
+    expect(screen.getAllByRole("link").map((link) => link.getAttribute("href"))).toEqual(links);
+    act(() => setLocale("en", false));
+    expect(screen.getByRole("heading", { name: "1. Set the region and analysis scope" })).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "Close" })).toBeInTheDocument();
+    expect(container.textContent?.replaceAll("/보고서작성", "")).not.toMatch(/[가-힣]/);
+  });
+});
