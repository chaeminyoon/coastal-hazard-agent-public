+  TileLayer: () => null, useMap: vi.fn(), useMapEvents: vi.fn(),
+}));
+vi.mock("./download", () => ({ downloadInBrowser: vi.fn() }));
+
+const rawMetric = { id: "강풍", label: "강풍", group: "위해성", grade_column: "강풍_등급", grade_counts: { "5": 2 } };
