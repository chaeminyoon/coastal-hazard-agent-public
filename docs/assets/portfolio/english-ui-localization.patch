+import { act, cleanup, fireEvent, render, screen, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import App from "./App";
+import { api } from "./api";
+import { setLocale } from "./i18n";
+
+beforeEach(() => {
+  setLocale("en", false);
+  vi.stubGlobal("fetch", vi.fn((url: string) => {
+    if (url === "/api/regions") return Promise.resolve({ ok: true, json: async () => [{ name: "부산광역시", districts: ["수영구"] }] });
+    throw new Error(`Unexpected request: ${url}`);
+  }));
+});
+afterEach(() => {
+  cleanup();
+  api.clearAuthState();
+  vi.unstubAllGlobals();
+});
+
+describe("English workspace localization", () => {
+  it("labels read-only archive preview honestly and disables live submissions", async () => {
+    render(<App readOnlyPreview />);
+    await screen.findByRole("combobox", { name: "Province or metropolitan city" });
+    expect(screen.getByText("READ-ONLY REVIEW")).toBeInTheDocument();
+    expect(screen.getByText("Live dataset not connected")).toBeInTheDocument();
+    expect(screen.queryByText("ANALYSIS READY")).not.toBeInTheDocument();
+    expect(screen.queryByText("Source data connected")).not.toBeInTheDocument();
+    const composer = screen.getByRole("textbox");
+    expect(composer).toHaveAttribute("readonly");
+    expect(screen.getByRole("button", { name: "Send message" })).toBeDisabled();
+    const starters = document.querySelector(".starter-grid") as HTMLElement;
+    for (const button of within(starters).getAllByRole("button")) expect(button).toBeDisabled();
+    fireEvent.change(composer, { target: { value: "Never run this preview query" } });
+    fireEvent.submit(document.querySelector(".chat-composer")!);
+    expect(vi.mocked(fetch).mock.calls.every(([, init]) => !init?.method || init.method === "GET")).toBe(true);
+  });
+  it("renders real English controls and switches the mounted workspace without changing input", async () => {
+    render(<App />);
+    await screen.findByRole("combobox", { name: "Province or metropolitan city" });
+    expect(screen.getByRole("heading", { name: "Coastal Risk Agent" })).toBeInTheDocument();
+    const composer = screen.getByPlaceholderText("Ask about coastal data or enter a supported command");
+    fireEvent.change(composer, { target: { value: "내 질문 / SELECT * FROM grid" } });
+    fireEvent.change(screen.getByRole("combobox", { name: "Language" }), { target: { value: "ko" } });
+    expect(screen.getByRole("heading", { name: "연안재해 에이전트" })).toBeInTheDocument();
+    expect(screen.getByPlaceholderText("연안 데이터에 대해 질문하거나 명령어를 입력하세요")).toHaveValue("내 질문 / SELECT * FROM grid");
+    act(() => setLocale("en", false));
+    expect(screen.getByRole("button", { name: "Send message" })).toBeInTheDocument();
+  });
+
+  it("keeps translated quick actions connected to the original supported Korean commands", async () => {
+    render(<App />);
+    await screen.findByRole("combobox", { name: "Province or metropolitan city" });
+    const actions = document.querySelector(".command-strip") as HTMLElement;
+    fireEvent.click(within(actions).getByRole("button", { name: "Create report" }));
+    expect(screen.getByRole("textbox")).toHaveValue("/보고서작성");
+    fireEvent.click(within(actions).getByRole("button", { name: "Compare exposure and vulnerability" }));
+    expect(screen.getByRole("textbox")).toHaveValue("노출성과 취약성 요인을 비교해줘");
+  });
+
+  it("renders and switches report settings and options at render time", async () => {
+    render(<App />);
+    await screen.findByRole("combobox", { name: "Province or metropolitan city" });
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: "지금까지 내용을 보고서로 만들어줘" } });
+    fireEvent.click(screen.getByRole("button", { name: "Send message" }));
+    const dialog = await screen.findByRole("dialog", { name: "Report settings" });
+    expect(within(dialog).getByRole("heading", { name: "Generate a report?" })).toBeInTheDocument();
+    expect(within(dialog).getByRole("button", { name: "Generate report" })).toBeInTheDocument();
+    act(() => setLocale("ko", false));
+    expect(screen.getByRole("dialog", { name: "보고서 작성 설정" })).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "보고서 생성" })).toBeInTheDocument();
+  });
+});
