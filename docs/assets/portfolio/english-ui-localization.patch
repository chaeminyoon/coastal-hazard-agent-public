+    source_crs: "EPSG:5179", grade_counts: { "5": 2 }, metrics: [rawMetric],
+  });
+  vi.spyOn(api, "spatialFeatures").mockResolvedValue({ type: "FeatureCollection", features: [], metadata: { count: 0, truncated: false } });
+});
+afterEach(() => { cleanup(); vi.restoreAllMocks(); setLocale("ko", false); });
+
+describe("SpatialStudio presentation locale", () => {
+  it("localizes controls and known metric labels live without changing schema or API values", async () => {
+    render(<SpatialStudio {...props()} />);
+    expect(await screen.findByRole("option", { name: "Strong wind" })).toHaveValue("강풍");
+    expect(screen.getByRole("group", { name: "Hazard" })).toBeInTheDocument();
