+import { useSyncExternalStore } from "react";
+
+export type UiLocale = "en" | "ko";
+const storageKey = "coastal.ui.locale";
+export function resolveLocale(query: string | null | undefined, stored: string | null | undefined): UiLocale {
+  if (query === "en" || query === "ko") return query;
+  if (stored === "en" || stored === "ko") return stored;
+  return "en";
+}
+function initialLocale(): UiLocale {
+  if (typeof window === "undefined") return "en";
+  let stored: string | null = null;
+  try { stored = window.localStorage.getItem(storageKey); } catch { /* Storage may be unavailable. */ }
+  return resolveLocale(new URLSearchParams(window.location.search).get("lang"), stored);
+}
+let currentLocale: UiLocale = initialLocale();
+const listeners = new Set<() => void>();
+function syncDocument() {
+  if (typeof document !== "undefined") document.documentElement.lang = currentLocale;
+}
+syncDocument();
+export function getLocale(): UiLocale { return currentLocale; }
+export function setLocale(next: UiLocale, persist = true): void {
+  if (next !== "en" && next !== "ko") return;
+  currentLocale = next;
+  syncDocument();
+  if (persist && typeof window !== "undefined") {
+    try { window.localStorage.setItem(storageKey, next); } catch { /* UI still works without storage. */ }
+  }
+  for (const listener of listeners) listener();
+}
+function subscribe(listener: () => void) { listeners.add(listener); return () => { listeners.delete(listener); }; }
+export function useLocale() {
+  const locale = useSyncExternalStore(subscribe, getLocale, () => "en" as UiLocale);
+  return { locale, setLocale };
+}
+/** Translate presentation text only. Never pass schema identifiers, SQL, user content or API keys here. */
+export function tr(korean: string, english: string): string { return currentLocale === "ko" ? korean : english; }
+export function localeCode(): "en-CA" | "ko-KR" { return currentLocale === "ko" ? "ko-KR" : "en-CA"; }
+export function formatUiNumber(value: number, options?: Intl.NumberFormatOptions): string {
+  return new Intl.NumberFormat(localeCode(), options).format(value);
+}
+export function formatUiDate(value: Date | string | number, options?: Intl.DateTimeFormatOptions): string {
+  const date = value instanceof Date ? value : new Date(value);
+  return Number.isNaN(date.getTime()) ? String(value) : new Intl.DateTimeFormat(localeCode(), options).format(date);
+}
