# Example configuration. Keep real secrets and datasets outside this repository.
COASTAL_ENV=development
MCP_FONT_FAMILY=Pretendard GOV
COASTAL_HTTP_BIND=127.0.0.1
COASTAL_HTTP_PORT=8080
COASTAL_AGENT_ROOT=/absolute/path/to/compatible-analysis-engine
COASTAL_ALLOWED_ORIGINS=http://localhost:8080

COASTAL_POSTGRES_DB=coastal
COASTAL_POSTGRES_USER=coastal
COASTAL_POSTGRES_PASSWORD=change-me-postgres
COASTAL_DATABASE_URL=postgresql+psycopg://coastal:change-me-postgres@postgres:5432/coastal

COASTAL_REDIS_PASSWORD=change-me-redis
COASTAL_REDIS_URL=redis://:change-me-redis@redis:6379/0

# python -c "import secrets; print(secrets.token_urlsafe(48))" 로 생성합니다.
COASTAL_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
